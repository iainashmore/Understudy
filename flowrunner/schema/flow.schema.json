{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flowrunner/flow.schema.json",
  "title": "Prompt flow",
  "type": "object",
  "required": [
    "version",
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target_app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "storage_state": {
              "type": "string"
            },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "cdp_url": {
              "description": "Attach to a Chromium already running in another process (WebView2/CEF) instead of launching one, e.g. http://127.0.0.1:9222",
              "type": "string"
            },
            "page_url_pattern": {
              "description": "Glob selecting which attached page to drive.",
              "type": "string"
            },
            "page_title_pattern": {
              "description": "Glob selecting which attached page to drive.",
              "type": "string"
            },
            "navigate": {
              "description": "In attach mode, navigate the attached page to `url` first. Off by default: the host is usually already where it needs to be.",
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "cdp_url"
              ]
            }
          ]
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable": {
              "type": "string"
            },
            "window_title_pattern": {
              "type": "string"
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 10
        },
        "stable_for_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    },
    "interstitials": {
      "description": "Dismissed if present before every step. For cookie banners and similar, which appear unpredictably and are not part of the flow.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reset": {
      "description": "Steps run before each prompt variant. Level-1 in-app reset.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "web": {
          "$ref": "#/$defs/strategyList"
        },
        "native": {
          "$ref": "#/$defs/strategyList"
        },
        "intent": {
          "description": "Plain-language description of what this element is for. Unused by deterministic replay; it is the guidance an agent-assisted resolver would need if the UI moves.",
          "type": "string"
        }
      }
    },
    "strategyList": {
      "description": "One strategy, or several tried in order, most stable first. A bare string is a CSS selector (web) for brevity.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "click",
            "type",
            "read",
            "capture",
            "wait_for_stable",
            "wait_for_element",
            "key"
          ]
        },
        "target": {
          "type": "string"
        },
        "optional": {
          "description": "Skip the step cleanly if the target never appears.",
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "comment": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "click"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {}
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "type"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target",
              "text"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "text": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "type",
                  "fill"
                ]
              },
              "clear": {
                "type": "boolean"
              },
              "delay_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "read"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target",
              "store_as"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "store_as": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "capture"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "label"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "label": {
                "type": "string",
                "minLength": 1
              },
              "full_page": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "wait_for_stable"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "until_hidden": {
                "type": "string"
              },
              "stable_for_ms": {
                "type": "integer",
                "minimum": 0
              },
              "poll_interval_ms": {
                "type": "integer",
                "minimum": 10
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "wait_for_element"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "state": {
                "type": "string",
                "enum": [
                  "attached",
                  "visible",
                  "hidden",
                  "enabled"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "key"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "keys"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "keys": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
