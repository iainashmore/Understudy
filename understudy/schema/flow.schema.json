{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/understudy/flow.schema.json",
  "title": "Prompt flow",
  "type": "object",
  "required": [
    "version",
    "name",
    "prompts",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target_app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "storage_state": {
              "type": "string"
            },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "cdp_url": {
              "description": "Attach to a Chromium already running in another process (WebView2/CEF) instead of launching one, e.g. http://127.0.0.1:9222",
              "type": "string"
            },
            "page_url_pattern": {
              "description": "Glob selecting which attached page to drive.",
              "type": "string"
            },
            "page_title_pattern": {
              "description": "Glob selecting which attached page to drive.",
              "type": "string"
            },
            "navigate": {
              "description": "In attach mode, navigate the attached page to `url` first. Off by default: the host is usually already where it needs to be.",
              "type": "boolean"
            },
            "typing": {
              "description": "How text is entered. 'human' types character by character at a fast typing speed, which also exercises whatever the application does between keystrokes; 'instant' fills the field.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "human",
                    "instant"
                  ]
                },
                "cps": {
                  "description": "Characters per second. 12 is about 145 wpm.",
                  "type": "number",
                  "minimum": 0.5
                },
                "variance": {
                  "type": "number",
                  "minimum": 0
                },
                "sentence_pause_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "clause_pause_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_total_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "record": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "framerate": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "mouse": {
              "description": "How the pointer moves. 'human' travels to the target so a screen recording is followable; 'instant' teleports, which is faster for unattended sweeps. On the web backend these are CDP input events: the page's hover states follow the path, but the desktop cursor does not move.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "human",
                    "instant"
                  ]
                },
                "speed": {
                  "type": "number",
                  "minimum": 1
                },
                "arc": {
                  "type": "number",
                  "minimum": 0
                },
                "settle_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "step_rate": {
                  "type": "number",
                  "minimum": 1
                },
                "input": {
                  "description": "Where clicks come from. 'cdp' dispatches synthetic events into the page: the page reacts, but the desktop cursor does not move, so an external screen recorder sees nothing. 'os' moves and clicks the real Windows cursor at the page's position on screen. 'auto' (the default) means 'os' when attached to another application's browser, which is the embedded-panel case, and 'cdp' otherwise.",
                  "type": "string",
                  "enum": [
                    "auto",
                    "cdp",
                    "os"
                  ]
                }
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "cdp_url"
              ]
            }
          ]
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable": {
              "type": "string"
            },
            "window_title_pattern": {
              "type": "string"
            },
            "process": {
              "description": "Image name of the process that must own the window, e.g. CATIA.exe. For applications that run as several processes owning windows of the same name, where the title cannot tell them apart on its own. Case-insensitive; the .exe is optional.",
              "type": "string"
            },
            "monitor": {
              "description": "Device name of the monitor the window must be on, e.g. \\\\\\\\.\\\\DISPLAY2. Anchors and regions are captured per monitor and do not survive a DPI change, so the run refuses to start on the wrong one.",
              "type": "string"
            },
            "launch": {
              "description": "Start `executable` rather than attaching to an already-running window.",
              "type": "boolean"
            },
            "mouse": {
              "description": "How the pointer moves. 'human' travels to the target so a screen recording is followable; 'instant' teleports, which is faster for unattended sweeps.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "human",
                    "instant"
                  ]
                },
                "speed": {
                  "type": "number",
                  "minimum": 1
                },
                "arc": {
                  "type": "number",
                  "minimum": 0
                },
                "settle_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "step_rate": {
                  "type": "number",
                  "minimum": 1
                }
              }
            },
            "typing": {
              "description": "How text is entered. 'human' types character by character at a fast typing speed, which also exercises whatever the application does between keystrokes; 'instant' fills the field.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "human",
                    "instant"
                  ]
                },
                "cps": {
                  "description": "Characters per second. 12 is about 145 wpm.",
                  "type": "number",
                  "minimum": 0.5
                },
                "variance": {
                  "type": "number",
                  "minimum": 0
                },
                "sentence_pause_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "clause_pause_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_total_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "record": {
              "description": "Screen capture via ffmpeg. Defaults to the whole monitor the window is on, because menus and dialogs fall outside the window rectangle. 'window' captures the window alone. Output is H.264 mp4, no audio.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "monitor",
                    "window"
                  ]
                },
                "framerate": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 10
        },
        "stable_for_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    },
    "interstitials": {
      "description": "Dismissed if present before every step. For cookie banners and similar, which appear unpredictably and are not part of the flow.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reset": {
      "description": "Steps run before each prompt variant. Level-1 in-app reset.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "description": {
      "description": "What this flow does, for the collection listing and the report.",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompts": {
      "description": "Prompt variants. Every flow carries its own: one file is the whole test.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "title": {
      "description": "Human-readable title. `name` is the identifier used in paths and results; this is what a person reads.",
      "type": "string"
    },
    "subject": {
      "description": "What is under test: which application, which assistant, which version. A reply is only comparable against another reply if you know what produced each one. The flow declares what it is meant to run against; a run records what it actually ran against, and the run wins.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string",
          "description": "e.g. CATIA V5"
        },
        "app_version": {
          "type": "string",
          "description": "e.g. R32 SP4"
        },
        "model": {
          "type": "string",
          "description": "the assistant, e.g. LEO"
        },
        "model_version": {
          "type": "string",
          "description": "e.g. 2026x FD01"
        },
        "release": {
          "type": "string",
          "description": "release or build number"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "web": {
          "$ref": "#/$defs/strategyList"
        },
        "native": {
          "$ref": "#/$defs/strategyList"
        },
        "intent": {
          "description": "Plain-language description of what this element is for. Unused by deterministic replay; it is the guidance an agent-assisted resolver would need if the UI moves.",
          "type": "string"
        }
      }
    },
    "strategyList": {
      "description": "One strategy, or several tried in order, most stable first. A bare string is a CSS selector (web) for brevity.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "click",
            "type",
            "read",
            "capture",
            "wait_for_stable",
            "wait_for_element",
            "key"
          ]
        },
        "target": {
          "type": "string"
        },
        "optional": {
          "description": "Skip the step cleanly if the target never appears.",
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "comment": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "click"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {}
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "type"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target",
              "text"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "text": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "type",
                  "fill"
                ]
              },
              "clear": {
                "type": "boolean"
              },
              "delay_ms": {
                "description": "Fixed milliseconds between keystrokes, overriding the app's typing style for this step.",
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "read"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "store_as"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "store_as": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "$ref": "#/$defs/region"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "text",
                  "ocr"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "capture"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "label"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "label": {
                "type": "string",
                "minLength": 1
              },
              "full_page": {
                "type": "boolean"
              },
              "region": {
                "$ref": "#/$defs/region"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "wait_for_stable"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "until_hidden": {
                "type": "string"
              },
              "require_change": {
                "description": "Wait for the watched area to change before it can count as settled. On by default: an assistant that thinks before it types leaves its panel unchanged, and 'unchanged' would otherwise be satisfied instantly by an empty answer. Turn off only when waiting for something to stop moving rather than start arriving.",
                "type": "boolean"
              },
              "stable_for_ms": {
                "type": "integer",
                "minimum": 0
              },
              "poll_interval_ms": {
                "type": "integer",
                "minimum": 10
              },
              "region": {
                "$ref": "#/$defs/region"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "text",
                  "pixels"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "wait_for_element"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "target"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "state": {
                "type": "string",
                "enum": [
                  "attached",
                  "visible",
                  "hidden",
                  "enabled"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "key"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "keys"
            ],
            "properties": {
              "action": {},
              "target": {},
              "optional": {},
              "timeout_ms": {},
              "comment": {},
              "keys": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "region": {
      "description": "Rectangle in window coordinates. Scopes a screenshot or a stability check to part of the surface.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "offset": {
      "description": "Click point relative to the centre of the located anchor. Lets a flow anchor on something that does not change -- a label, an icon -- and act on a neighbouring control whose appearance does.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dx",
        "dy"
      ],
      "properties": {
        "dx": {
          "type": "integer"
        },
        "dy": {
          "type": "integer"
        }
      }
    }
  }
}
