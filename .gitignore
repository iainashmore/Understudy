__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
traces/
results/

# Credentials. The real file lives in ~/.understudy by default; these patterns
# cover the case where someone points the UI at a path inside the repository.
credentials.json
.understudy/
**/credentials.json
!credentials.example.json

# Anchors the agent learned, and cached step narration: run artefacts, not source.
learned/
narration/

# Packaged builds. The installer is a release asset, not a repository file.
# Anchored to the repository root: an unanchored `build/` also matches
# desktop/build/, which holds the icon -- and `git add -A` skips an ignored
# file without a word, so the first anyone knew was electron-builder failing
# to find an icon that was sitting right there on disk.
/dist/
/build/
desktop/node_modules/
desktop/release/
packaging/payload/
